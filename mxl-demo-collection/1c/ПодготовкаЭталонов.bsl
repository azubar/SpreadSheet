// Подготовка эталонов для компоненты SpreadSheet.
//
// Для каждого файла *.mxl из КаталогИсходных сохраняет в КаталогРезультатов:
//   <имя>.pdf  — как этот документ печатает сама 1С (разбиение на страницы,
//                масштаб, поля, ориентация, колонтитулы);
//   <имя>.json — параметры печати и число страниц по мнению 1С.
// По этим файлам проверяется режим «как при печати» компоненты.
//
// Запуск: внешняя обработка, общий модуль или «Выполнить произвольный код».
// Работает и на клиенте, и на сервере (PDF на сервере — с 8.3.x без
// установленного принтера используются параметры по умолчанию).
//
// ВНИМАНИЕ: скрипт подготовлен без доступа к 1С и не запускался. Если
// какое-то свойство недоступно в вашей версии платформы — удалите строку
// и сообщите, какую.

Процедура ПодготовитьЭталоныSpreadSheet(КаталогИсходных, КаталогРезультатов) Экспорт
	
	Разделитель = ПолучитьРазделительПути();
	СоздатьКаталог(КаталогРезультатов);
	Файлы = НайтиФайлы(КаталогИсходных, "*.mxl", Ложь);
	
	Для Каждого Файл Из Файлы Цикл
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(Файл.ПолноеИмя);
		Основа = КаталогРезультатов + Разделитель + Файл.ИмяБезРасширения;
		
		ТабДок.Записать(Основа + ".pdf", ТипФайлаТабличногоДокумента.PDF);
		
		Сведения = Новый Структура;
		Сведения.Вставить("Файл", Файл.Имя);
		Сведения.Вставить("ВерсияПлатформы", ВерсияПлатформы());
		Сведения.Вставить("КоличествоСтраниц", ТабДок.КоличествоСтраниц());
		Сведения.Вставить("РазмерСтраницы", ТабДок.РазмерСтраницы);
		Сведения.Вставить("ШиринаСтраницы", ТабДок.ШиринаСтраницы);
		Сведения.Вставить("ВысотаСтраницы", ТабДок.ВысотаСтраницы);
		Сведения.Вставить("ОриентацияСтраницы", Строка(ТабДок.ОриентацияСтраницы));
		Сведения.Вставить("МасштабПечати", ТабДок.МасштабПечати);
		Сведения.Вставить("АвтоМасштаб", ТабДок.АвтоМасштаб);
		Сведения.Вставить("ПолеСверху", ТабДок.ПолеСверху);
		Сведения.Вставить("ПолеСлева", ТабДок.ПолеСлева);
		Сведения.Вставить("ПолеСнизу", ТабДок.ПолеСнизу);
		Сведения.Вставить("ПолеСправа", ТабДок.ПолеСправа);
		Сведения.Вставить("РазмерКолонтитулаСверху", ТабДок.РазмерКолонтитулаСверху);
		Сведения.Вставить("РазмерКолонтитулаСнизу", ТабДок.РазмерКолонтитулаСнизу);
		Сведения.Вставить("ЧерноБелаяПечать", ТабДок.ЧерноБелаяПечать);
		Сведения.Вставить("ВысотаТаблицы", ТабДок.ВысотаТаблицы);
		Сведения.Вставить("ШиринаТаблицы", ТабДок.ШиринаТаблицы);
		Сведения.Вставить("ОбластьПечати", ИмяОбласти(ТабДок.ОбластьПечати));
		Сведения.Вставить("ПовторятьПриПечатиСтроки", ИмяОбласти(ТабДок.ПовторятьПриПечатиСтроки));
		Сведения.Вставить("ПовторятьПриПечатиКолонки", ИмяОбласти(ТабДок.ПовторятьПриПечатиКолонки));
		Сведения.Вставить("ВерхнийКолонтитул", ТабДок.ВерхнийКолонтитул.Выводить);
		Сведения.Вставить("НижнийКолонтитул", ТабДок.НижнийКолонтитул.Выводить);
		
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(Основа + ".json", "UTF-8");
		ЗаписатьJSON(Запись, Сведения);
		Запись.Закрыть();
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяОбласти(Область)
	
	Если Область = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Область.Имя;
	
КонецФункции

