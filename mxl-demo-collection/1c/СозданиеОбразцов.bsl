// Создание образцов MXL для доработок компоненты SpreadSheet.
//
// Создаёт в Каталог файлы, которых нет в mxl-demo-collection:
//   ОбразецЗначенияИФорматы.mxl  — ячейки со значениями (число, дата,
//       булево) и форматными строками, параметры макета;
//   ОбразецВозможностиТекста.mxl — выравнивание по ширине, отступ, углы
//       текста, скрытая строка, свёрнутая группировка, примечание;
//   ОбразецПечать_<вариант>.mxl  — длинная таблица с шапкой, колонтитулами
//       и повтором строк при разных параметрах печати (формат листа,
//       ориентация, масштаб, автомасштаб, поля).
// После создания запустите ПодготовитьЭталоныSpreadSheet (файл
// ПодготовкаЭталонов.bsl) для этого же каталога — получатся PDF и JSON 1С.
//
// ВНИМАНИЕ: скрипт подготовлен без доступа к 1С и не запускался. Если
// какое-то свойство недоступно в вашей версии платформы — закомментируйте
// строку и сообщите, какую.

Процедура СоздатьОбразцыSpreadSheet(Каталог) Экспорт
	
	СоздатьКаталог(Каталог);
	Разделитель = ПолучитьРазделительПути();
	
	СоздатьОбразецЗначений().Записать(
		Каталог + Разделитель + "ОбразецЗначенияИФорматы.mxl", ТипФайлаТабличногоДокумента.MXL);
	СоздатьОбразецТекста().Записать(
		Каталог + Разделитель + "ОбразецВозможностиТекста.mxl", ТипФайлаТабличногоДокумента.MXL);
	
	// Варианты параметров печати: Имя, РазмерСтраницы, Ориентация, Масштаб, АвтоМасштаб, Поле
	Варианты = Новый Массив;
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A4_Книжная_100", "A4", Ложь, 100, Ложь, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A4_Альбомная_100", "A4", Истина, 100, Ложь, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A4_Книжная_70", "A4", Ложь, 70, Ложь, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A4_Книжная_Авто", "A4", Ложь, 100, Истина, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A3_Альбомная_100", "A3", Истина, 100, Ложь, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A5_Книжная_100", "A5", Ложь, 100, Ложь, 5));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "Letter_Книжная_100", "Letter", Ложь, 100, Ложь, 10));
	Варианты.Добавить(Новый Структура("Имя, Размер, Альбомная, Масштаб, Авто, Поле", "A4_Книжная_Поля25", "A4", Ложь, 100, Ложь, 25));
	
	Для Каждого Вариант Из Варианты Цикл
		ТабДок = СоздатьДлиннуюТаблицу();
		ТабДок.РазмерСтраницы = Вариант.Размер;
		ТабДок.ОриентацияСтраницы = ?(Вариант.Альбомная, ОриентацияСтраницы.Ландшафт, ОриентацияСтраницы.Портрет);
		ТабДок.АвтоМасштаб = Вариант.Авто;
		Если Не Вариант.Авто Тогда
			ТабДок.МасштабПечати = Вариант.Масштаб;
		КонецЕсли;
		ТабДок.ПолеСверху = Вариант.Поле;
		ТабДок.ПолеСнизу = Вариант.Поле;
		ТабДок.ПолеСлева = Вариант.Поле;
		ТабДок.ПолеСправа = Вариант.Поле;
		ТабДок.Записать(Каталог + Разделитель + "ОбразецПечать_" + Вариант.Имя + ".mxl",
			ТипФайлаТабличногоДокумента.MXL);
	КонецЦикла;
	
КонецПроцедуры

Функция Ячейка(ТабДок, НомерСтроки, НомерКолонки)
	
	Возврат ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	
КонецФункции

// Строка: описание (колонка 1), ячейка со значением и форматом (колонка 2).
Процедура ВывестиЗначение(ТабДок, НомерСтроки, Значение, ФорматнаяСтрока, Описание)
	
	Ячейка(ТабДок, НомерСтроки, 1).Текст = Описание + ": " + ФорматнаяСтрока;
	ЯчейкаЗначения = Ячейка(ТабДок, НомерСтроки, 2);
	ЯчейкаЗначения.СодержитЗначение = Истина;
	ЯчейкаЗначения.Значение = Значение;
	ЯчейкаЗначения.Формат = ФорматнаяСтрока;
	
КонецПроцедуры

Функция СоздатьОбразецЗначений()
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область(1, 1, 1, 1).ШиринаКолонки = 50;
	ТабДок.Область(1, 2, 1, 2).ШиринаКолонки = 35;
	Ячейка(ТабДок, 1, 1).Текст = "Значения ячеек и форматные строки";
	
	Дата = Дата(2026, 7, 19, 14, 30, 5);
	Строки = Новый Массив;
	// Число
	Строки.Добавить(Новый Структура("З, Ф, О", 1234567.891, "", "Число без формата"));
	Строки.Добавить(Новый Структура("З, Ф, О", 1234567.891, "ЧДЦ=2", "Два знака"));
	Строки.Добавить(Новый Структура("З, Ф, О", 1234567.891, "ЧДЦ=2; ЧРД=,; ЧРГ=' '", "Разделители"));
	Строки.Добавить(Новый Структура("З, Ф, О", 1234567.891, "ЧДЦ=2; ЧГ=0", "Без групп"));
	Строки.Добавить(Новый Структура("З, Ф, О", 1234567.891, "ЧЦ=12; ЧДЦ=3; ЧВН=", "Ведущие нули"));
	Строки.Добавить(Новый Структура("З, Ф, О", -1234.5, "ЧДЦ=2", "Отрицательное"));
	Строки.Добавить(Новый Структура("З, Ф, О", -1234.5, "ЧДЦ=2; ЧО=0", "Отрицательное, ЧО=0"));
	Строки.Добавить(Новый Структура("З, Ф, О", 0, "ЧДЦ=2", "Ноль"));
	Строки.Добавить(Новый Структура("З, Ф, О", 0, "ЧДЦ=2; ЧН=-", "Ноль, ЧН=-"));
	Строки.Добавить(Новый Структура("З, Ф, О", 1500000, "ЧС=3; ЧДЦ=1", "Сдвиг, тыс."));
	// Дата
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "", "Дата без формата"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДФ=dd.MM.yyyy", "ДФ"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДФ='d MMMM yyyy ""г.""'", "ДФ с месяцем"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДЛФ=D", "ДЛФ=D"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДЛФ=DD", "ДЛФ=DD"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДЛФ=DT", "ДЛФ=DT"));
	Строки.Добавить(Новый Структура("З, Ф, О", Дата, "ДЛФ=T", "ДЛФ=T"));
	Строки.Добавить(Новый Структура("З, Ф, О", '00010101', "ДП='не указана'", "Пустая дата"));
	// Булево и строка
	Строки.Добавить(Новый Структура("З, Ф, О", Истина, "", "Булево Истина"));
	Строки.Добавить(Новый Структура("З, Ф, О", Ложь, "БЛ=Нет; БИ=Да", "Булево Ложь, БЛ/БИ"));
	Строки.Добавить(Новый Структура("З, Ф, О", "строковое значение", "", "Строка"));
	
	НомерСтроки = 3;
	Для Каждого Описание Из Строки Цикл
		ВывестиЗначение(ТабДок, НомерСтроки, Описание.З, Описание.Ф, Описание.О);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	// Параметр макета (типовая печатная форма: ячейка с заполнением «Параметр»)
	НомерСтроки = НомерСтроки + 1;
	Ячейка(ТабДок, НомерСтроки, 1).Текст = "Параметр «Сумма»: ЧДЦ=2";
	ЯчейкаПараметра = Ячейка(ТабДок, НомерСтроки, 2);
	ЯчейкаПараметра.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
	ЯчейкаПараметра.Параметр = "Сумма";
	ЯчейкаПараметра.Формат = "ЧДЦ=2";
	ТабДок.Параметры.Сумма = 98765.43;
	
	НомерСтроки = НомерСтроки + 1;
	Ячейка(ТабДок, НомерСтроки, 1).Текст = "Шаблон «Итого [Сумма] руб.»";
	ЯчейкаШаблона = Ячейка(ТабДок, НомерСтроки, 2);
	ЯчейкаШаблона.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон;
	ЯчейкаШаблона.Текст = "Итого [Сумма2] руб.";
	ТабДок.Параметры.Сумма2 = 1234.5;
	
	Возврат ТабДок;
	
КонецФункции

Функция СоздатьОбразецТекста()
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область(1, 1, 1, 4).ШиринаКолонки = 25;
	ДлинныйТекст = "Текст, выровненный по ширине: пробелы между словами растягиваются так, чтобы строки занимали всю ширину ячейки.";
	
	Ячейка(ТабДок, 1, 1).Текст = "Возможности текста";
	
	// По ширине
	Область = ТабДок.Область(3, 1, 3, 2);
	Область.Объединить();
	Область.Текст = ДлинныйТекст;
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.ПоШирине;
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	ТабДок.Область(3, 1, 3, 1).ВысотаСтроки = 60;
	
	// Отступ
	Для Отступ = 0 По 3 Цикл
		ЯчейкаОтступа = Ячейка(ТабДок, 5 + Отступ, 1);
		ЯчейкаОтступа.Текст = "Отступ " + Отступ;
		ЯчейкаОтступа.Отступ = Отступ;
	КонецЦикла;
	ЯчейкаАвто = Ячейка(ТабДок, 9, 1);
	ЯчейкаАвто.Текст = "АвтоОтступ 2";
	ЯчейкаАвто.АвтоОтступ = 2;
	
	// Углы текста
	Углы = Новый Массив;
	Углы.Добавить(45);
	Углы.Добавить(90);
	Углы.Добавить(180);
	Углы.Добавить(270);
	Для Индекс = 0 По Углы.ВГраница() Цикл
		ЯчейкаУгла = Ячейка(ТабДок, 11, Индекс + 1);
		ЯчейкаУгла.Текст = "Угол " + Углы[Индекс];
		ЯчейкаУгла.ОриентацияТекста = Углы[Индекс];
		ЯчейкаУгла.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ЯчейкаУгла.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	КонецЦикла;
	ТабДок.Область(11, 1, 11, 1).ВысотаСтроки = 80;
	
	// Скрытая строка
	Ячейка(ТабДок, 13, 1).Текст = "Строка 13 видима";
	Ячейка(ТабДок, 14, 1).Текст = "Строка 14 СКРЫТА — не должна выводиться";
	ТабДок.Область(14, , 14).Видимость = Ложь;
	Ячейка(ТабДок, 15, 1).Текст = "Строка 15 видима";
	
	// Примечание
	ЯчейкаПримечания = Ячейка(ТабДок, 17, 1);
	ЯчейкаПримечания.Текст = "Ячейка с примечанием";
	ЯчейкаПримечания.Примечание.Текст = "Текст примечания";
	
	// Свёрнутая группировка строк (вывод через макет)
	Макет = Новый ТабличныйДокумент;
	Макет.Область(1, 1, 1, 1).Текст = "Строка внутри СВЁРНУТОЙ группы";
	ОбластьСтроки = Макет.ПолучитьОбласть(1, , 1);
	Заголовок = Новый ТабличныйДокумент;
	Заголовок.Область(1, 1, 1, 1).Текст = "Заголовок группы (строки ниже свёрнуты)";
	ТабДок.Вывести(Заголовок.ПолучитьОбласть(1, , 1));
	ТабДок.НачатьГруппуСтрок("Группа", Ложь);
	ТабДок.Вывести(ОбластьСтроки);
	ТабДок.Вывести(ОбластьСтроки);
	ТабДок.ЗакончитьГруппуСтрок();
	
	Возврат ТабДок;
	
КонецФункции

Функция СоздатьДлиннуюТаблицу()
	
	ТабДок = Новый ТабличныйДокумент;
	КолонокВсего = 10;
	Для Колонка = 1 По КолонокВсего Цикл
		ТабДок.Область(1, Колонка, 1, Колонка).ШиринаКолонки = 15;
	КонецЦикла;
	
	Шапка = ТабДок.Область(1, 1, 1, КолонокВсего);
	Шапка.Объединить();
	Шапка.Текст = "Образец печати: длинная таблица с шапкой и колонтитулами";
	Шапка.Шрифт = Новый Шрифт("Arial", 12, Истина);
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Для Колонка = 1 По КолонокВсего Цикл
		ЯчейкаЗаголовка = Ячейка(ТабДок, 2, Колонка);
		ЯчейкаЗаголовка.Текст = "Колонка " + Колонка;
		ЯчейкаЗаголовка.Шрифт = Новый Шрифт("Arial", 9, Истина);
		ЯчейкаЗаголовка.ЦветФона = Новый Цвет(221, 235, 247);
		ЯчейкаЗаголовка.Обвести(Линия, Линия, Линия, Линия);
	КонецЦикла;
	
	Для НомерСтроки = 3 По 150 Цикл
		Для Колонка = 1 По КолонокВсего Цикл
			ЯчейкаДанных = Ячейка(ТабДок, НомерСтроки, Колонка);
			ЯчейкаДанных.Текст = "R" + Формат(НомерСтроки, "ЧГ=0") + "C" + Колонка;
			ЯчейкаДанных.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
	КонецЦикла;
	
	ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Область(2, , 2);
	ТабДок.ВерхнийКолонтитул.Выводить = Истина;
	ТабДок.ВерхнийКолонтитул.ТекстСлева = "Верхний колонтитул слева";
	ТабДок.ВерхнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	ТабДок.НижнийКолонтитул.Выводить = Истина;
	ТабДок.НижнийКолонтитул.ТекстВЦентре = "Нижний колонтитул по центру";
	
	Возврат ТабДок;
	
КонецФункции

// Пример вызова:
// СоздатьОбразцыSpreadSheet("C:\SpreadSheet\образцы");
// ПодготовитьЭталоныSpreadSheet("C:\SpreadSheet\образцы", "C:\SpreadSheet\эталоны");
